{
  "name": "blue-horizon-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "web app",
    "mobile app"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=\"web app\"",
    "build": "npm run build --workspace=\"web app\"",
    "sync": "npm run build --workspace=\"web app\" && npx cap sync android --workspace=\"mobile app\""
  }
}
